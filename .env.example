# Development database: the local Postgres from docker-compose.yml (`pnpm db:up`).
# Server-side only — deliberately not VITE_-prefixed.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/hm_archiv_dev

# Signing key of the administrator's session cookie, at least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Hash of the administrator's password. Generate with: pnpm admin:password <heslo>
ADMIN_PASSWORD_HASH=

# Token for `pnpm skills:push`, which sends skill texts from their files to the
# running application (/api/skills). At least 32 characters; empty switches the
# endpoint off. Generate with: openssl rand -base64 32
SKILLS_API_TOKEN=
# Where `pnpm skills:push` sends them. Empty means SITE_URL.
SKILLS_API_URL=

# Public address of the site, used in the links of /rss.xml. Needed behind a proxy,
# where the application sees only the proxy's own address. Leave empty for local
# development: the feed then uses the address it was asked at.
SITE_URL=

# File storage. With this token files go to Vercel Blob (private access);
# without it they go to the folder below. Leave empty for local development.
BLOB_READ_WRITE_TOKEN=
STORAGE_DIR=.data/storage

# AI that reads documents. A model is written as provider:model; providers are
# "anthropic" and "openai". Only the key of a provider in use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Reads scanned pages and describes images (must accept images and PDF).
AI_OCR_MODEL=openai:gpt-6.1-terra
# Writes the name and the short description from extracted text.
AI_DESCRIPTION_MODEL=openai:gpt-6-luna
# Prices in US dollars per million tokens, [input, output]. Adds to or corrects
# the table in src/server/ai/prices.ts. Example: {"openai:gpt-5":[1.25,10]}
AI_PRICES=
# Judges recorded sessions and proposes better skills. Runs only on request.

# Chat over the archive. The chat model must be able to call a tool; the
# embedding model must give 1536 numbers (the size of the database column).
AI_CHAT_MODEL=openai:gpt-6.1-terra
# Writes the queries of the first search from the question, the conversation and the glossary.
AI_REWRITE_MODEL=openai:gpt-6-luna
AI_EMBEDDING_MODEL=openai:text-embedding-3-small
# Small decisions, by Jev of TypeSafe: the category of a processed document,
# and for every chat search the weights of the two branches and the
# reranking of the found pieces (two calls). `off` switches all of it off, and so does a
# missing key. A category less sure than AI_CATEGORY_CONFIDENCE (0.7) goes to
# the fallback category.
AI_DECISION_MODEL=typesafe:jev-latest
TYPESAFE_API_KEY=
# Writes the glossary of the chat from all documents (pnpm glossary:build). Runs only on request.
AI_GLOSSARY_MODEL=openai:gpt-6.1-sol
# Limits against misuse: questions per visitor in an hour, and from all visitors in a day.
CHAT_HOURLY_LIMIT=20
CHAT_DAILY_LIMIT=300
# More numbers of the chat (pieces, search, fusion) are listed in src/server/chat/settings.ts.

# MLflow: every chat question becomes a trace there, and the visitor's rating of
# an answer becomes feedback on it. Leave the address empty to send nothing.
# The server is the Openship app from docker/mlflow/app.json.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# The test questions (`pnpm eval:sync`, `pnpm eval:run`) read the same four
# names from `.env.eval`, which wins over this file: the experiment of the
# tests and its own MLflow user, so test answers never mix with visitors'.

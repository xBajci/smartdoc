{
  "name": "hm-archiv",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "demo:files": "node scripts/build-demo-files.mjs",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-command.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-command.ts",
    "import:prepare": "tsx --env-file-if-exists=.env src/server/import/prepare-command.ts",
    "import:load": "tsx --env-file-if-exists=.env src/server/import/load-command.ts",
    "chat:index": "tsx --env-file-if-exists=.env src/server/chat/index-command.ts",
    "search:eval": "tsx --import ./scripts/raw-loader.mjs --env-file-if-exists=.env src/server/chat/search-eval-command.ts",
    "eval:sync": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.eval src/server/chat/eval-sync-command.ts",
    "eval:run": "tsx --import ./scripts/raw-loader.mjs --env-file-if-exists=.env --env-file-if-exists=.env.eval src/server/chat/eval-run-command.ts",
    "categories:assign": "tsx --import ./scripts/raw-loader.mjs --env-file-if-exists=.env src/server/categorize-command.ts",
    "skills:push": "tsx --env-file-if-exists=.env src/server/skills-push-command.ts",
    "admin:password": "tsx src/server/hash-password-command.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/openai": "4.0.115",
    "@ai-sdk/otel": "1.0.170",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@vercel/blob": "2.8.0",
    "ai": "7.0.170",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.72.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  }
}

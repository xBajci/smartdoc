{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    ".output/**",
    ".vercel/**",
    ".claude/**",
    "dist/**",
    "public/**",
    "playwright-report/**",
    "test-results/**",
    "pnpm-lock.yaml",
    "**/*.md"
  ]
}
